GOOGLE_PLACES_API_KEY=
TOMORROW_IO_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side ONLY. Bypasses RLS. Required for cron
# alerts to update last_alerted_at and for unsubscribe to null emails.
SUPABASE_SERVICE_ROLE_KEY=

# Affiliate booking. Use {query} as a placeholder — it will be replaced
# with the URL-encoded course name at click time.
# Example (GolfNow via Impact Radius):
# NEXT_PUBLIC_GOLFNOW_AFFILIATE_URL=https://golfnow.pxf.io/c/<your-id>/<program-id>/12345?u=https%3A%2F%2Fwww.golfnow.com%2Ftee-times%2F%3Fsearchtext%3D{query}
NEXT_PUBLIC_GOLFNOW_AFFILIATE_URL=

# Alerts
RESEND_API_KEY=
RESEND_FROM_EMAIL=Rain Check <onboarding@resend.dev>
# Random secret shared with Vercel Cron (Vercel sets this automatically as the
# Authorization header when set as a project env var). Generate with:
#   openssl rand -hex 32
CRON_SECRET=
# Public URL used in email links (unsubscribe, course pages). Set to your
# production URL in Vercel; leave localhost for dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000
